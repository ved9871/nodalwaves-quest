# ── NodalWaves Quest — backend environment ─────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# Core (required)
DATABASE_URL="mysql://user:password@host:3306/nodalwaves_quest"
JWT_SECRET="generate-a-long-random-string"      # signs session cookies (HS256)
NODE_ENV="production"
PORT="3000"
APP_BASE_URL="https://nodewavesquest.com"        # public URL; used to build OAuth redirect URIs

# First admin bootstrap (optional): a matching OAuth openId is auto-promoted to admin.
# For email/password accounts, use scripts/make-admin.mjs instead.
OWNER_OPEN_ID=""

# ── Email / SMTP (password reset). Without these, reset still works but the code
#    is logged to the server console instead of emailed. ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@nodewavesquest.com"
SMTP_FROM_NAME="NodalWaves Quest"

# ── Google login (direct OAuth). Set both to turn on "Continue with Google". ──
# Google Cloud Console -> Credentials -> OAuth client (Web).
# Authorized redirect URI: {APP_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Legacy Manus OAuth broker (only if you keep Manus-brokered login) ──
VITE_APP_ID=""
OAUTH_SERVER_URL=""
VITE_OAUTH_PORTAL_URL=""

# ── Temporary beta review page (optional) ──
ADMIN_REVIEW_TOKEN=""
ADMIN_REVIEW_EXPIRES=""
